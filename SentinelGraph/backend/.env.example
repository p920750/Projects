# SentinelGraph Backend Environment Configuration Example
PORT=8000
HOST=0.0.0.0

# FalkorDB Database Connection
# For Local Docker: localhost:6379, sentinel_soc, no user/password
# For FalkorDB Cloud: cloud endpoint, port, username, password, SSL
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=sentinel_soc
FALKORDB_USER=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
# Optional full connection URL (e.g. falkor://user:password@host:port or falkors://...)
# FALKORDB_URL=
